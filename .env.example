NODE_ENV=development
PORT=4000
# Use "memory" for instant local development without installing MongoDB,
# or paste your MongoDB Atlas connection string:
MONGODB_URI=memory
JWT_SECRET=replace-with-a-random-32-char-secret
PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=*

# Seeded on first start if no admin user exists yet:
ADMIN_NAME=HearCare Admin
ADMIN_EMAIL=admin@hearcare.local
ADMIN_PASSWORD=ChangeMe123!

# SMS provider: console | africastalking | beem
SMS_PROVIDER=console
SMS_SENDER_ID=HearCare
AT_USERNAME=sandbox
AT_API_KEY=
BEEM_API_KEY=
BEEM_SECRET=
SMS_REMINDERS=true

# Optional reviewer test account for Play Store / App Store review:
REVIEW_PHONE=
REVIEW_OTP=

MIN_APP_VERSION=1.0.0
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We are improving HearCare. Please try again soon.
SUPPORT_PHONE=+255700000000
SUPPORT_WHATSAPP=+255700000000

RUN_JOBS=true
SEED_DEMO=true
